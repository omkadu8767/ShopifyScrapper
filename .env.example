# Server Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3000

# Shopify API Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here
SHOPIFY_API_VERSION=2024-10

# AI Translation API (Choose one)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Translation Settings
TARGET_LANGUAGE=en
# Options: ro (Romanian), en (English), etc.

# Pricing Configuration
PRICE_MARKUP_PERCENTAGE=2.5
# Example: 2.5 = 250% markup (multiply by 2.5)

PRICE_MARKUP_FIXED=15
# Example: 15 = add 15 RON to each price

CNY_TO_RON_RATE=0.68
# Current exchange rate from Chinese Yuan to Romanian Leu

ENABLE_99_ROUNDING=true
# true = prices end with .99 (e.g., 49.99)

# Image Processing
IMAGE_FORMAT=webp
# Options: webp, jpg, png

IMAGE_QUALITY=85
# 1-100, higher = better quality but larger file size

MAX_IMAGE_WIDTH=2048
# Maximum width in pixels

# Scraper Configuration
SCRAPER_TIMEOUT=30000
# Timeout in milliseconds

HEADLESS_BROWSER=true
# true = run browser in background, false = show browser window

# Rate Limiting
RATE_LIMIT_WINDOW=15
# Time window in minutes

RATE_LIMIT_MAX_REQUESTS=10
# Max requests per window

# Database
DATABASE_PATH=./backend/database.sqlite

# Python Environment
PYTHON_PATH=backend/venv/Scripts/python.exe
# Path to Python executable (Windows example: backend/venv/Scripts/python.exe, Linux/Mac: backend/venv/bin/python3)
